# Evoroom — локальная разработка
NODE_ENV=development

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-evoroom-dev-secret
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://evoroom:evoroom@localhost:5432/evoroom?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=evoroom
MINIO_SECRET_KEY=evoroomsecret
MINIO_BUCKET=evoroom
MINIO_USE_SSL=false
# URL MinIO из контейнера egress (docker DNS)
MINIO_EGRESS_ENDPOINT=http://minio:9000

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Mail (dev: ethereal/log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@evoroom.local

# --- Прод (evo-room.com), пример значений на VDS ---
# NODE_ENV=production
# APP_URL=https://evo-room.com
# API_URL=https://evo-room.com
# LIVEKIT_PUBLIC_URL=wss://livekit.evo-room.com
